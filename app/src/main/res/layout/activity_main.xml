<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:padding="16dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Симулятор терминала"
        android:textColor="#4ECCA3"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <EditText
        android:id="@+id/panInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Номер карты"
        android:text="4276000000000001"
        android:textColor="#FFFFFF"
        android:textColorHint="#94A3B8"
        android:inputType="number"
        android:background="#0F3460"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/expInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Срок MM/YY"
        android:text="12/27"
        android:textColor="#FFFFFF"
        android:textColorHint="#94A3B8"
        android:background="#0F3460"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/cvvInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="CVV"
        android:text="123"
        android:textColor="#FFFFFF"
        android:textColorHint="#94A3B8"
        android:inputType="number"
        android:background="#0F3460"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/amountInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Сумма (руб)"
        android:text="150.00"
        android:textColor="#FFFFFF"
        android:textColorHint="#94A3B8"
        android:inputType="numberDecimal"
        android:background="#0F3460"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/payButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Оплатить"
        android:textColor="#1A1A2E"
        android:backgroundTint="#4ECCA3"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/cardsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Показать карты"
        android:textColor="#EEEEEE"
        android:backgroundTint="#1E4D7B"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/resultView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:layout_marginTop="16dp"
        android:textColor="#EEEEEE"
        android:fontFamily="monospace"
        android:textSize="13sp"/>

  </LinearLayout>
</ScrollView>
